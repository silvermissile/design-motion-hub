{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "news-documentary-video",
  "title": "News Documentary Video",
  "title_i18n": {
    "zh-CN": "新闻纪实风格代码视频"
  },
  "version": "1.0.0",
  "description": "End-to-end news documentary code video production workflow: fact research, 6-act in-medias-res storyboard, Wikimedia portraits, Incompetech news BGM, VAD voice mixing, vintage newspaper cutouts, charts, and audio/visual QA checklist.",
  "description_i18n": {
    "zh-CN": "端到端新闻纪实风格代码视频生产指南：事实调研、6 幕倒叙分镜、人物肖像与新闻配乐采集、VAD 配音混音、复古报纸剪纸与视听 QA 门禁。"
  },
  "author": {
    "name": "SerenaMugua",
    "url": "https://github.com/SerenaMugua/news-documentary-video-skill"
  },
  "license": "CC-BY-NC-SA-4.0",
  "homepage": "https://github.com/SerenaMugua/news-documentary-video-skill",
  "tags": ["news", "documentary", "video", "storyboard", "journalism", "charts", "audio-qa"],
  "compat": {
    "agentSkills": [{ "path": "./SKILL.md" }]
  },
  "od": {
    "kind": "skill",
    "taskKind": "new-generation",
    "mode": "video",
    "scenario": "video",
    "preview": {
      "type": "html",
      "entry": "./showcase.html",
      "poster": "./preview/01_newspaper_open.png",
      "motion": "static"
    },
    "useCase": {
      "query": "Produce a 6-act news-documentary style code video with vintage newspaper cutouts, data charts, and audio/visual QA for {{topic}}.",
      "exampleOutputs": [
        { "path": "./showcase.html", "title": "News Documentary 4-Act Case Showcase" }
      ]
    },
    "context": {
      "assets": [
        "./showcase.html",
        "./preview/01_newspaper_open.png",
        "./preview/02_scandal_cutout.png",
        "./preview/03_stock_surge.png",
        "./preview/04_aroll_quote.png"
      ]
    },
    "inputs": [
      { "name": "topic", "type": "string", "required": true }
    ],
    "capabilities": ["prompt:inject", "fs:write"]
  }
}
